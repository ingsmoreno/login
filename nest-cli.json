{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/login/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/login/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/login",
  "projects": {
    "login": {
      "type": "application",
      "root": "apps/login",
      "entryFile": "main",
      "sourceRoot": "apps/login/src",
      "compilerOptions": {
        "tsConfigPath": "apps/login/tsconfig.app.json"
      }
    },
    "products": {
      "type": "application",
      "root": "apps/products",
      "entryFile": "main",
      "sourceRoot": "apps/products/src",
      "compilerOptions": {
        "tsConfigPath": "apps/products/tsconfig.app.json"
      }
    },
    "mailapp": {
      "type": "application",
      "root": "apps/mailapp",
      "entryFile": "main",
      "sourceRoot": "apps/mailapp/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mailapp/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    },
    "signup": {
      "type": "application",
      "root": "apps/signup",
      "entryFile": "main",
      "sourceRoot": "apps/signup/src",
      "compilerOptions": {
        "tsConfigPath": "apps/signup/tsconfig.app.json"
      }
    }
  }
}